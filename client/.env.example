# Leave empty in development to use the Vite /api proxy.
# In production, point this at your API origin (e.g. https://api.subplug.ng).
# The API MUST be same-origin or a subdomain of the SPA's registrable domain.
# A different site (e.g. SPA on example.com, API on my-api.onrender.com) will
# fail on iPhone/Safari because Safari blocks third-party cookies.
VITE_API_URL=
VITE_APP_NAME=SubPlug
VITE_API_PROXY_TARGET=http://localhost:4000
