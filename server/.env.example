# ───────────────────────────────────────────────────────────────
# SubPlug server configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
# ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173
# Comma-separated list of additional allowed browser origins
ADDITIONAL_CORS_ORIGINS=

# MongoDB. Production MUST be a replica set (transactions required).
MONGODB_URI=mongodb://127.0.0.1:27017/subplug
# Refuse to boot in production unless the database is a replica set
REQUIRE_REPLICA_SET=true
# ── Authentication ─────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_DOMAIN=
# Use `none` only when the API and web app are on different sites (requires HTTPS)
COOKIE_SAME_SITE=lax
# Trust the first reverse-proxy hop (Render/Railway/Nginx). Set false when direct.
TRUST_PROXY=1

# ── Seed administrator (used by `npm run seed`) ────────────────
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Platform Owner
ADMIN_PHONE=08000000000

# ── Payment gateways (Paystack and/or Flutterwave) ─────────────
# PAYMENT_GATEWAY is the pre-selected method. Add other methods to
# PAYMENT_GATEWAYS (comma-separated) to let customers choose per top-up.
# Use TEST keys in development.
PAYMENT_GATEWAY=flutterwave           # paystack | flutterwave
PAYMENT_GATEWAYS=                     # e.g. paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
# https://developer.flutterwave.com/docs
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
# Set any random value here and enter the same value as the "secret hash" on
# the Flutterwave dashboard webhook. Required for live Flutterwave funding.
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
# Enable Virtual Accounts for your Flutterwave merchant account to issue
# dedicated NIN-backed account numbers from the customer dashboard.
# Reserved for automated tests only; customer test funding is disabled.
ALLOW_MOCK_PAYMENTS=false
PAYMENT_CURRENCY=NGN

# ── VTU provider (SME API) ─────────────────────────────────────
# mock       = deterministic sandbox adapter (never used for live fulfilment)
# sme        = live SME API adapter (https://smeapi.com.ng)
# maskawasub = live MaskawaSub adapter (secondary; see certification flag below)
VTU_PROVIDER=sme
ALLOW_MOCK_VTU=false
VTU_API_BASE_URL=https://smeapi.com.ng
# Keep this only in server/.env. Never commit it or expose it to the client.
VTU_API_KEY=
VTU_TIMEOUT_MS=15000
# Optional JSON file with the numeric provider/plan IDs enabled on your SME API
# account for cable TV and electricity. Airtime, data and status do not need it.
# See server/config/vtu-catalogue.example.json.
VTU_CATALOGUE_FILE=

# ── Secondary VTU provider (MaskawaSub) ───────────────────────
# MaskawaSub is used for catalogue reads and as the routed provider for
# cable/electricity while SME remains the airtime/data provider. Never expose
# these credentials to the client.
MASKAWASUB_API_BASE_URL=https://maskawasub.com
MASKAWASUB_API_KEY=
# Live purchases stay disabled until the purchase/status contract has been
# certified against a funded test. Reads and health checks remain available.
MASKAWASUB_LIVE_PURCHASES=false
# Comma-separated per-service allowlist. Keep empty until each service has passed
# a controlled live certification. Valid values: AIRTIME,DATA,CABLE,ELECTRICITY.
MASKAWASUB_CERTIFIED_SERVICES=

# Per-service routing. Airtime and data can also be switched at runtime from
# Admin → Providers; the runtime choice is stored in the providerRouting
# system setting and overrides the values below. Empty = VTU_PROVIDER.
# Cable and electricity are fixed to MaskawaSub in code; the legacy variables
# are retained for compatibility but are not used to select another provider.
# Switching a route never retries an in-flight purchase on the other provider;
# it only selects the provider before the wallet is debited.
VTU_BACKUP_PROVIDER=maskawasub
VTU_AIRTIME_PROVIDER=
VTU_DATA_PROVIDER=
VTU_CABLE_PROVIDER=maskawasub
VTU_ELECTRICITY_PROVIDER=maskawasub
VTU_EDUCATION_PROVIDER=
VTU_AIRTIME_TO_CASH_PROVIDER=
VTU_RECHARGE_CARD_PROVIDER=

# ── Redis / BullMQ (optional) ──────────────────────────────────
# When disabled, reconciliation runs on an in-process interval (single instance only).
USE_QUEUES=false
REDIS_URL=redis://127.0.0.1:6379
RECONCILE_INTERVAL_MS=300000
# Refresh live SME API prices and availability (minimum 60 seconds).
CATALOGUE_SYNC_INTERVAL_MS=900000

# ── Email (optional in development) ────────────────────────────
EMAIL_FROM="SubPlug <no-reply@example.com>"
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
# Development-only: log verification/reset URLs and return them to the client.
EXPOSE_DEV_EMAILS=true
# Development-only convenience. Never enable in production.

# ── Security / operations ──────────────────────────────────────
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
TRANSACTION_EMAIL_ALERTS=true
METRICS_TOKEN=
# Emergency-only: permit mock payment/VTU providers in production. Leave false.
ALLOW_SANDBOX_IN_PRODUCTION=false
