# ───────────────────────────────────────────────────────────────
# SubPlug server configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
# ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173
# Comma-separated list of additional allowed browser origins
ADDITIONAL_CORS_ORIGINS=

# MongoDB. Production MUST be a replica set (transactions required).
MONGODB_URI=mongodb://127.0.0.1:27017/subplug
# Refuse to boot in production unless the database is a replica set
REQUIRE_REPLICA_SET=true
# ── Authentication ─────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_DOMAIN=
# Use `none` only when the API and web app are on different sites (requires HTTPS)
COOKIE_SAME_SITE=lax
# Trust the first reverse-proxy hop (Render/Railway/Nginx). Set false when direct.
TRUST_PROXY=1

# ── Seed administrator (used by `npm run seed`) ────────────────
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Platform Owner
ADMIN_PHONE=08000000000

# ── Payment gateway (Paystack) ─────────────────────────────────
# https://paystack.com/docs/api/ — use TEST keys in development.
PAYMENT_GATEWAY=mock                 # mock | paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
# Mock payments are sandbox-only and always labelled as such in the UI.
ALLOW_MOCK_PAYMENTS=true
PAYMENT_CURRENCY=NGN

# ── VTU provider (SME API) ─────────────────────────────────────
# mock = deterministic sandbox adapter (never used for live fulfilment)
# sme  = live SME API adapter (https://smeapi.com.ng)
VTU_PROVIDER=sme
ALLOW_MOCK_VTU=false
VTU_API_BASE_URL=https://smeapi.com.ng
# Keep this only in server/.env. Never commit it or expose it to the client.
VTU_API_KEY=
VTU_TIMEOUT_MS=15000
# Optional JSON file with the numeric provider/plan IDs enabled on your SME API
# account for cable TV and electricity. Airtime, data and status do not need it.
# See server/config/vtu-catalogue.example.json.
VTU_CATALOGUE_FILE=

# ── Redis / BullMQ (optional) ──────────────────────────────────
# When disabled, reconciliation runs on an in-process interval (single instance only).
USE_QUEUES=false
REDIS_URL=redis://127.0.0.1:6379
RECONCILE_INTERVAL_MS=300000
# Refresh live SME API prices and availability (minimum 60 seconds).
CATALOGUE_SYNC_INTERVAL_MS=900000

# ── Email (optional in development) ────────────────────────────
EMAIL_FROM="SubPlug <no-reply@example.com>"
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
# Development-only: log verification/reset URLs and return them to the client.
EXPOSE_DEV_EMAILS=true
# Development-only convenience. Never enable in production.
AUTO_VERIFY_EMAILS=false

# ── Security / operations ──────────────────────────────────────
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
TRANSACTION_EMAIL_ALERTS=true
METRICS_TOKEN=
# Emergency-only: permit mock payment/VTU providers in production. Leave false.
ALLOW_SANDBOX_IN_PRODUCTION=false
